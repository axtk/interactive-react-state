{
  "name": "react-stategear",
  "version": "0.8.1",
  "description": "A shared state management and routing lib for React apps",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.mjs",
      "require": "./dist/state.cjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.mjs",
      "require": "./dist/router.cjs"
    }
  },
  "scripts": {
    "demo": "npx auxsrv tests/Shared_state_without_Context",
    "preversion": "npx npm-run-all shape test",
    "shape": "npx codeshape --compile-input index.ts state.ts router.ts",
    "t3": "npx auxsrv tests/Tic-tac-toe",
    "test": "npx playwright test --project=chromium",
    "typecheck": "npx codeshape typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axtk/react-stategear.git"
  },
  "keywords": [
    "state",
    "state management",
    "react state management",
    "shared state",
    "global state",
    "routing",
    "react router"
  ],
  "license": "MIT",
  "author": "axtk",
  "allowScripts": {
    "esbuild": true
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auxsrv": "^0.3.21",
    "immer": "11.2.9",
    "react-dom": "^19.3.1",
    "url-shape": "^2.1.6",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "stategear": "^0.8.0"
  }
}
